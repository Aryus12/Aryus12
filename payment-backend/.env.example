# ===== GENIUSPAY API CONFIGURATION =====
# IMPORTANT: Remplacez ces valeurs par vos vraies clés GeniusPay
# Ne partagez jamais ces clés et ne les committez pas sur Git

# Clé API GeniusPay (Public Key)
GENIUSPAY_API_KEY=votre_cle_api_publique_ici

# Secret API GeniusPay (Private Key)
GENIUSPAY_API_SECRET=votre_cle_api_secrete_ici

# Endpoint GeniusPay API
GENIUSPAY_ENDPOINT=https://api.geniuspay.com/v1

# Mode de paiement (sandbox ou production)
GENIUSPAY_MODE=sandbox

# URL de callback après paiement (webhook)
GENIUSPAY_WEBHOOK_URL=https://votre-domaine.com/api/payment/webhook

# URL de redirection après succès (page de téléchargement)
GENIUSPAY_SUCCESS_URL=https://votre-domaine.com/payment-success.html

# URL de redirection après échec
GENIUSPAY_CANCEL_URL=https://votre-domaine.com/index.html

# ===== SÉCURITÉ =====
# Clé secrète pour signer les requêtes (JWT)
JWT_SECRET=votre_cle_secrete_jwt_tres_longue_et_aleatoire

# Clé de chiffrement pour les données sensibles
ENCRYPTION_KEY=votre_cle_de_chiffrement_32_caracteres

# ===== APPLICATION =====
# URL de base de votre application
NEXT_PUBLIC_APP_URL=https://votre-domaine.com

# Port du serveur (développement)
PORT=3001
